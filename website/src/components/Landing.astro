---
import '../styles/global.css';
import { translations, type Lang } from '../i18n';
import AppleIcon from './icons/AppleIcon.astro';
import WindowsIcon from './icons/WindowsIcon.astro';
import HeroScreenshot from './HeroScreenshot.astro';
import FeatureRow from './FeatureRow.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = translations[lang];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const REPO_URL = 'https://github.com/chanwoong528/omniterm';
const RELEASES_URL = `${REPO_URL}/releases`;
const LATEST_URL = `${REPO_URL}/releases/latest`;
// 미서명 앱 경고 해결 안내. 언어별 README의 해당 섹션 앵커로 보낸다(제목을 바꾸면 앵커도 바뀐다).
const installGuideHref =
  lang === 'en'
    ? `${REPO_URL}#running-without-the-damaged-warning`
    : `${REPO_URL}/blob/main/README.ko.md#손상됨-경고-없이-실행하기`;

const SITE = 'https://chanwoong528.github.io';
const koUrl = `${SITE}${base}/`;
const enUrl = `${SITE}${base}/en/`;
const homeHref = lang === 'en' ? `${base}/en/` : `${base}/`;

/* 헤더 링크 터치 영역(44px, Apple HIG).
   헤더 높이(53px)는 그대로 두고 ::after만 링크 밖으로 넓힌다.
   좌우 확장 폭은 이웃 링크와 겹치지 않도록 링크 사이 간격 안에서 나눠 가진다.
   - 메뉴 간격: gap-4(16px) / sm:gap-5(20px)
   - GitHub과 KO 사이: gap + 구분선 1px + pl-4(16px) / sm:pl-5(20px)
   - KO와 EN 사이: gap-3(12px) + "/" + gap-3(12px) / sm:gap-1.5(6px)
   640px 미만은 GitHub(아이콘만)·KO·EN을 44px씩 겹치지 않게 놓을 자리가 모자라
   KO/EN 간격만 넓혔다. EN 오른쪽은 화면 끝(nav px-4 = 16px)에서 막힌다. */
const TOUCH_Y_TEXT_SM = 'relative after:absolute after:-inset-y-3'; // 20px 줄 높이 + 12px×2 = 44px
// 16px 높이(GitHub 아이콘, KO/EN 줄) + 14px×2 = 44px. KO/EN의 text-xs 줄 높이 calc(1/0.75)는
// Safari가 15px로 잘라 43px이 되므로, 언어 전환 그룹에 leading-4(16px)를 줘서 줄 높이를 고정한다.
const TOUCH_Y_TEXT_XS = 'relative after:absolute after:-inset-y-3.5';
const touchTargetClass = {
  features: `${TOUCH_Y_TEXT_SM} after:-inset-x-2.5`,
  download: `${TOUCH_Y_TEXT_SM} after:inset-x-0`,
  // 좁은 폭에서는 16px 아이콘만 보이므로 좌우로 넓히고, sm 이상에서는 글자 폭으로 충분하다.
  github: `${TOUCH_Y_TEXT_XS} after:-left-[15px] after:-right-[13px] sm:after:-inset-y-3 sm:after:inset-x-0`,
  // KO 오른쪽 + EN 왼쪽 확장 합(10 + 14 = 24px)이 둘 사이 간격(12 + "/" + 12)을 넘지 않는다.
  ko: `${TOUCH_Y_TEXT_XS} after:-left-[19px] after:-right-2.5 sm:after:-left-6 sm:after:-right-1.5`,
  en: `${TOUCH_Y_TEXT_XS} after:-left-3.5 after:-right-4 sm:after:-left-2 sm:after:-right-5`,
};
const LANG_LINK_ACTIVE = 'text-zinc-100';
const LANG_LINK_INACTIVE = 'text-zinc-400 transition hover:text-zinc-200';
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32.png`} />
    <link rel="canonical" href={lang === 'en' ? enUrl : koUrl} />
    <link rel="alternate" hreflang="ko" href={koUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={koUrl} />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'ko_KR'} />
  </head>
  <body class="bg-zinc-950 text-zinc-100 antialiased">
    <!-- Nav -->
    <header class="sticky top-0 z-10 border-b border-zinc-800/80 bg-zinc-950/80 backdrop-blur">
      <nav class="mx-auto flex max-w-5xl items-center justify-between gap-3 px-4 py-3.5 sm:gap-5 sm:px-6">
        <a href={homeHref} class="flex shrink-0 items-center gap-2.5 font-semibold tracking-tight">
          <img src={`${base}/logo-64.png`} alt="" width="24" height="24" class="h-6 w-6 rounded" />
          {/* 좁은 폭에서는 아이콘만 남긴다. sr-only는 화면에서만 감추므로 링크 이름은 그대로 남는다. */}
          <span class="sr-only sm:not-sr-only">OmniTerm</span>
        </a>
        <div class="flex items-center gap-4 text-sm text-zinc-400 sm:gap-5">
          {/* whitespace-nowrap이 없으면 한국어 라벨은 글자마다 줄바꿈이 가능해
              min-content 너비가 한 글자가 되고, flex가 세로 한 줄로 짜부라뜨린다. */}
          <a href="#features" class:list={['whitespace-nowrap transition hover:text-zinc-100', touchTargetClass.features]}
            >{t.navFeatures}</a
          >
          <a href="#download" class:list={['whitespace-nowrap transition hover:text-zinc-100', touchTargetClass.download]}
            >{t.navDownload}</a
          >
          <a
            href={REPO_URL}
            target="_blank"
            rel="noopener"
            class:list={['flex shrink-0 items-center gap-1.5 transition hover:text-zinc-100', touchTargetClass.github]}
          >
            <svg viewBox="0 0 16 16" class="h-4 w-4 fill-current" aria-hidden="true">
              <path
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
              ></path>
            </svg>
            <span class="sr-only sm:not-sr-only">GitHub</span>
          </a>
          <span
            class="flex shrink-0 items-center gap-3 border-l border-zinc-800 pl-4 text-xs leading-4 font-medium sm:gap-1.5 sm:pl-5"
            aria-label="Language"
          >
            <a
              href={`${base}/`}
              class:list={[lang === 'ko' ? LANG_LINK_ACTIVE : LANG_LINK_INACTIVE, touchTargetClass.ko]}
              aria-current={lang === 'ko' ? 'page' : undefined}>KO</a
            >
            <span class="text-zinc-700" aria-hidden="true">/</span>
            <a
              href={`${base}/en/`}
              class:list={[lang === 'en' ? LANG_LINK_ACTIVE : LANG_LINK_INACTIVE, touchTargetClass.en]}
              aria-current={lang === 'en' ? 'page' : undefined}>EN</a
            >
          </span>
        </div>
      </nav>
    </header>

    <main>
      <!-- Hero -->
      <section class="mx-auto max-w-5xl px-6 pt-20 pb-14 text-center">
        <p
          class="mx-auto mb-5 inline-flex items-center gap-2 rounded-full border border-zinc-800 bg-zinc-900 px-3 py-1 text-xs text-zinc-400"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
          <span id="version">{t.badgeLatest}</span> · {t.badgeSuffix}
        </p>
        <h1 class="mx-auto max-w-3xl text-4xl font-bold tracking-tight text-balance sm:text-5xl">
          {t.heroLine}<br class="sm:hidden" />
          <span class="bg-gradient-to-r from-emerald-400 to-cyan-400 bg-clip-text text-transparent">{t.heroGradient}</span>
        </h1>
        <p class="mx-auto mt-5 max-w-2xl text-lg text-zinc-400 text-pretty">
          {t.heroSub}
        </p>

        <div id="download" class="mt-9 flex flex-col items-center gap-3">
          {/* 버튼 색 클래스(bg-·text-·border-·shadow-)는 아래 스크립트가 Windows 방문자일 때 서로 맞바꾼다.
              아키텍처 줄은 opacity로 흐리게 해 어느 버튼 색에서도 글자색을 따라간다. */}
          <div class="flex flex-wrap items-center justify-center gap-3">
            <a
              id="btn-mac"
              href={LATEST_URL}
              class="inline-flex items-center gap-3 rounded-lg bg-zinc-100 px-6 py-3 text-left font-semibold text-zinc-900 shadow-lg transition hover:bg-white"
            >
              <AppleIcon class="h-6 w-6 shrink-0" />
              <span class="flex flex-col leading-tight">
                <span>{t.btnMac}</span>
                <span class="text-xs font-normal opacity-75">{t.btnMacArch}</span>
              </span>
            </a>
            <a
              id="btn-win"
              href={LATEST_URL}
              class="inline-flex items-center gap-3 rounded-lg border border-zinc-700 bg-zinc-900 px-6 py-3 text-left font-semibold transition hover:border-zinc-500"
            >
              <WindowsIcon class="h-[18px] w-[18px] shrink-0" />
              <span class="flex flex-col leading-tight">
                <span>{t.btnWin}</span>
                <span class="text-xs font-normal opacity-75">{t.btnWinArch}</span>
              </span>
            </a>
          </div>
          {/* 큰 macOS 버튼은 Apple Silicon용이다. Intel Mac 링크는 API가 실패해도 갈 곳이 있도록
              releases/latest로 먼저 그려 두고, 스크립트가 x64.dmg 주소로 바꾼다. */}
          <p class="mt-1 text-sm text-zinc-400">
            {t.intelPrompt}
            <span aria-hidden="true">→</span>
            <a
              id="link-intel"
              href={LATEST_URL}
              class="font-medium text-zinc-100 underline decoration-zinc-500 underline-offset-4 transition hover:decoration-zinc-100"
            >
              {t.intelLabel}
            </a>
          </p>
          <a
            href={RELEASES_URL}
            target="_blank"
            rel="noopener"
            class="text-xs text-zinc-400 underline decoration-zinc-700 underline-offset-2 transition hover:text-zinc-200"
          >
            {t.allReleases}
          </a>
        </div>
      </section>

      <!-- Screenshot -->
      <section class="mx-auto max-w-5xl px-6 pb-20">
        <HeroScreenshot alt={t.screenshotAlt} />
      </section>

      <!-- Features -->
      <section id="features" class="border-t border-zinc-900 bg-zinc-950">
        <div class="mx-auto max-w-5xl px-6 py-20">
          <h2 class="text-center text-3xl font-bold tracking-tight">{t.featuresTitle}</h2>
          <p class="mt-3 text-center text-zinc-400 text-pretty">{t.featuresSub}</p>
          {/* md 이상에서 첫 행은 이미지를 왼쪽에, 다음 행은 오른쪽에 번갈아 둔다. */}
          {/* list-style이 없는 목록은 Safari VoiceOver가 목록으로 읽지 않아 role을 다시 준다. */}
          <ul role="list" class="mt-14 flex flex-col gap-16 md:mt-16 md:gap-24">
            {
              t.features.map((feature, index) => (
                <FeatureRow
                  title={feature.title}
                  desc={feature.desc}
                  image={feature.image}
                  alt={feature.alt}
                  isImageOnRight={index % 2 === 1}
                />
              ))
            }
          </ul>
        </div>
      </section>

      <!-- Install note -->
      <section class="border-t border-zinc-900">
        <div class="mx-auto max-w-3xl px-6 py-16">
          <h2 class="text-xl font-bold">{t.installTitle}</h2>
          <p class="mt-3 text-sm leading-relaxed text-zinc-400 text-pretty">
            {t.installBody}
          </p>
          {/* 아이콘 칸 폭을 h-5 w-5로 고정해 "macOS"와 "Windows"의 글자 시작선을 맞춘다. */}
          <ul class="mt-4 space-y-2 text-sm text-zinc-400">
            <li class="flex gap-2">
              <span class="flex h-5 w-5 shrink-0 items-center justify-center text-zinc-400">
                <AppleIcon class="h-4 w-4" />
              </span>
              <span class="text-pretty">
                <strong class="text-zinc-200">macOS</strong> {t.installMacPre}
                <code class="rounded bg-zinc-800 px-1.5 py-0.5 font-mono text-xs text-emerald-300">xattr -cr /Applications/OmniTerm.app</code>
                {t.installMacPost}
                <a
                  href={installGuideHref}
                  target="_blank"
                  rel="noopener"
                  class="underline decoration-zinc-700 underline-offset-2 hover:text-zinc-200">{t.installMacLink}</a
                >
              </span>
            </li>
            <li class="flex gap-2">
              <span class="flex h-5 w-5 shrink-0 items-center justify-center text-zinc-400">
                <WindowsIcon class="h-3.5 w-3.5" />
              </span>
              <span class="text-pretty">
                <strong class="text-zinc-200">Windows</strong> {t.installWinPre}
                <strong class="text-zinc-200">{t.installWinStrong}</strong>{t.installWinPost}
              </span>
            </li>
          </ul>
        </div>
      </section>
    </main>

    <footer class="border-t border-zinc-900">
      <div class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-3 px-6 py-8 text-sm text-zinc-400 sm:flex-row">
        <p>{t.footerMade}</p>
        <a href={REPO_URL} target="_blank" rel="noopener" class="transition hover:text-zinc-200">{t.footerGithub}</a>
      </div>
    </footer>

    <script>
      // 최신 릴리스에서 OS별 설치 파일 링크를 가져와 버튼에 연결
      const REPO = 'chanwoong528/omniterm';

      async function wireDownloads() {
        const btnMac = document.getElementById('btn-mac') as HTMLAnchorElement | null;
        const btnWin = document.getElementById('btn-win') as HTMLAnchorElement | null;
        const linkIntel = document.getElementById('link-intel') as HTMLAnchorElement | null;
        const versionEl = document.getElementById('version');
        if (!btnMac || !btnWin) return;

        // 방문자 OS에 맞는 버튼을 앞으로 (기본은 macOS 우선)
        const ua = navigator.userAgent;
        if (/Windows/i.test(ua)) {
          btnWin.classList.remove('border', 'border-zinc-700', 'bg-zinc-900', 'hover:border-zinc-500');
          btnWin.classList.add('bg-zinc-100', 'text-zinc-900', 'shadow-lg', 'hover:bg-white');
          btnMac.classList.remove('bg-zinc-100', 'text-zinc-900', 'shadow-lg', 'hover:bg-white');
          btnMac.classList.add('border', 'border-zinc-700', 'bg-zinc-900', 'hover:border-zinc-500');
          btnWin.parentElement?.prepend(btnWin);
        }

        try {
          const res = await fetch(`https://api.github.com/repos/${REPO}/releases/latest`);
          if (!res.ok) return;
          const release = await res.json();
          const assets: { name: string; browser_download_url: string }[] = release.assets ?? [];
          const find = (re: RegExp) => assets.find((a) => re.test(a.name))?.browser_download_url;

          const macArm = find(/aarch64\.dmg$/i);
          const macIntel = find(/x64\.dmg$/i);
          const winSetup = find(/setup\.exe$/i) ?? find(/\.exe$/i) ?? find(/\.msi$/i);

          if (versionEl && release.tag_name) versionEl.textContent = release.tag_name;
          if (macArm) btnMac.href = macArm;
          if (winSetup) btnWin.href = winSetup;
          if (linkIntel && macIntel) linkIntel.href = macIntel;
        } catch {
          // API 실패 시 버튼과 Intel 링크는 releases/latest 페이지로 유지
        }
      }

      wireDownloads();
    </script>
  </body>
</html>
